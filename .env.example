# ============================================================
# Smart College Notes Exchange - Environment Variables Template
# Copy this file to .env in your root or configure per service:
# - Backend variables -> Configure in Render Web Service Environment
# - Frontend variables -> Configure in Netlify Site Configuration
#
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO VERSION CONTROL!
# ============================================================

# ============================================================
# 1. Backend & Database Configuration (Configure in Render)
# ============================================================

# Database Connection (Remote MySQL - e.g. Aiven, Clever Cloud, Railway, PlanetScale, AWS RDS)
# Format: jdbc:mysql://<HOST>:<PORT>/<DATABASE_NAME>?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_URL=jdbc:mysql://your-remote-mysql-host.com:3306/smart_college_notes?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Port (Render injects PORT automatically into the container; default is 8080)
PORT=8080

# JWT Security Configuration
# Secret key must be a secure random 256-bit (32+ characters) string
JWT_SECRET=replace_with_a_secure_random_256_bit_secret_key_minimum_32_characters
JWT_EXPIRATION_MS=86400000

# Google Gemini AI Configuration (Called exclusively on the backend)
# Obtain your free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# CORS Allowed Origins
# Comma-separated list of allowed URLs (e.g. your Netlify production domain and localhost)
ALLOWED_ORIGINS=https://your-app-name.netlify.app,http://localhost:5173

# Local storage directory for uploaded PDFs
UPLOAD_DIR=uploads/notes

# ============================================================
# 2. Frontend Configuration (Configure in Netlify)
# ============================================================

# Backend API Base URL
# Point this to your deployed Render web service URL (with or without /api)
# Example: https://smart-college-notes-backend.onrender.com/api
VITE_API_BASE_URL=https://your-spring-boot-app.onrender.com/api
