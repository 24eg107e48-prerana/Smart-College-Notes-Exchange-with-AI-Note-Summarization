# ============================================================
# Smart College Notes Exchange - Environment Variables Template
# Copy this file to .env in your root or configure in backend/frontend
# ============================================================

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/smart_college_notes?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Spring Boot Server
SERVER_PORT=8080

# JWT Security Configuration
# Must be at least 256 bits (32 bytes) hex or base64 encoded
JWT_SECRET=YOUR_256_BIT_SECRET_HEX_OR_BASE64_HERE
JWT_EXPIRATION_MS=86400000

# Google Gemini AI Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.8-flash

# Local Storage Directory for PDFs
UPLOAD_DIR=uploads/notes

# Frontend Configuration (React / Vite)
VITE_API_BASE_URL=http://localhost:8080/api
